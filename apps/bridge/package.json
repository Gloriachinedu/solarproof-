{
  "name": "@solarproof/bridge",
  "version": "0.1.0",
  "private": true,
  "description": "Energy Web Origin bridge microservice — issues ERC-1888 EAC tokens on Energy Web Chain for each new SolarProof certificate",
  "license": "UNLICENSED",
  "type": "commonjs",
  "main": "dist/index.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "ethers": "^6.13.2",
    "pg": "^8.12.0",
    "pino": "^9.3.2",
    "pino-pretty": "^11.2.2"
  },
  "devDependencies": {
    "@types/node": "^20.14.12",
    "@types/pg": "^8.11.6",
    "rimraf": "^5.0.9",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4"
  }
}